<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/w_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:textColor="#BFFFFFFF" android:text="Losgehen" />
        <TextView android:id="@+id/w_stand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#8CFFFFFF" android:text="" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="6dp"
            android:textSize="13sp" android:text="●" android:textColor="#FFFFFF" android:visibility="gone" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:text="Kalendarium" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
            <Chronometer android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="34sp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:textColor="#FFFFFF" android:visibility="gone" />
            <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="34sp" android:fontFamily="sans-serif-black" android:includeFontPadding="false" android:maxLines="1" android:textColor="#FFFFFF" android:text="…" />
        </FrameLayout>
        <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minWidth="40dp" android:gravity="center" android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textSize="15sp" android:fontFamily="sans-serif-black" android:textColor="#FFFFFF" android:background="@drawable/badge_subway" android:visibility="gone" android:text="U8" />
    </LinearLayout>
    <ProgressBar android:id="@+id/w_prog" style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp"
        android:max="100" android:progress="40" android:progressTint="#FFFFFF" android:progressBackgroundTint="#40FFFFFF" android:visibility="gone" />
    <ProgressBar android:id="@+id/w_prog_d" style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:layout_marginBottom="4dp"
        android:max="100" android:progress="40" android:progressTint="#111113" android:progressBackgroundTint="#33111113" android:visibility="gone" />
    <TextView android:id="@+id/w_l1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:textColor="#E6FFFFFF" android:text="" />
    <TextView android:id="@+id/w_l2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#BFFFFFFF" android:text="" />
    <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="#8CFFFFFF" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/w_a1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#BFFFFFFF" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/w_a2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#BFFFFFFF" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/w_a3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textColor="#BFFFFFFF" android:text="" android:visibility="gone" />
    <TextView android:id="@+id/w_dl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textSize="12sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:textColor="#8CFFFFFF" android:text="" android:visibility="gone" />
</LinearLayout>
